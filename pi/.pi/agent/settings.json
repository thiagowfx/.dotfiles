    "git:github.com/thiagowfx/skills",
    "local/web-search",
    "npm:pi-tool-display@0.5.0",
    "npm:pi-mcp-adapter@2.29.0",
    "npm:@zeldrisho/pi-web-fetch@0.7.0",
