{
  "compaction": {
    "enabled": true
  },
  "defaultModel": "gpt-6.1-sol",
  "defaultProvider": "openai-codex",
  "defaultThinkingLevel": "high",
  "defaultTools": [
    "+codemode"
  ],
  "doubleEscapeAction": "tree",
  "enableInstallTelemetry": false,
  "enabledModels": [
    "openai-codex/gpt-6-luna",
    "openai-codex/gpt-6.1-sol",
    "openai-codex/gpt-6-astra"
  ],
  "hideThinkingBlock": false,
  "httpIdleTimeoutMs": 30000,
  "lastChangelogVersion": "1.3.0",
  "packages": [
    "git:github.com/thiagowfx/skills",
    "local/web-search",
    "npm:@zeldrisho/pi-web-fetch@0.11.0",
    "npm:@nerisma/pi-auto-title@1.0.1",
    "npm:@tmustier/pi-session-recap@0.5.1",
    "npm:@juicesharp/rpiv-ask-user-question@2.13.9",
    "npm:@juicesharp/rpiv-todo@2.13.9",
    "npm:@sreetej510/pi-usage@0.11.7"
  ],
  "retry": {
    "baseDelayMs": 2000,
    "enabled": true,
    "maxRetries": 5
  },
  "showCacheMissNotices": true,
  "theme": "catppuccin-mocha",
  "treeFilterMode": "user-only",
  "tuiMode": "fullscreen"
}
