{
  "compaction": {
    "enabled": true
  },
  "defaultModel": "gpt-5.6-terra",
  "defaultProvider": "openai-codex",
  "defaultThinkingLevel": "high",
  "doubleEscapeAction": "tree",
  "enableInstallTelemetry": false,
  "enabledModels": [
    "anthropic/claude-haiku-4-5",
    "anthropic/claude-sonnet-5",
    "anthropic/claude-opus-5",
    "anthropic/claude-fable-5",
    "openai-codex/gpt-5.6-luna",
    "openai-codex/gpt-5.6-terra",
    "openai-codex/gpt-5.6-sol"
  ],
  "hideThinkingBlock": false,
  "httpIdleTimeoutMs": 30000,
  "lastChangelogVersion": "0.84.1",
  "packages": [
    "git:github.com/thiagowfx/skills",
    "local/pi-memory-write",
    "local/web-search",
    "npm:pi-tool-display@0.5.0",
    "npm:@tifan/pi-recap@0.4.4",
    "npm:@tintinweb/pi-subagents@0.15.0",
    "npm:pi-mcp-adapter@2.21.2",
    "npm:@narumitw/pi-goal@0.50.0",
    "npm:@zeldrisho/pi-web-fetch@0.5.2",
    "npm:@nerisma/pi-auto-title@1.0.1",
    "npm:@mrclrchtr/supi-prompt-suggestions@4.8.0",
    "npm:pi-input-history@1.0.1"
  ],
  "retry": {
    "baseDelayMs": 2000,
    "enabled": true,
    "maxRetries": 5
  },
  "showCacheMissNotices": true,
  "theme": "catppuccin-mocha",
  "treeFilterMode": "user-only",
  "warnings": {
    "anthropicExtraUsage": false
  }
}
