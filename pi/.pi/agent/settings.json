{
  "compaction": {
    "enabled": true
  },
  "defaultModel": "gpt-6-sol",
  "defaultProvider": "openai-codex",
  "defaultThinkingLevel": "high",
  "doubleEscapeAction": "tree",
  "enableInstallTelemetry": false,
  "enabledModels": [
    "anthropic/claude-haiku-4-5",
    "anthropic/claude-sonnet-5",
    "anthropic/claude-opus-5",
    "anthropic/claude-fable-5",
    "openai-codex/gpt-6-luna",
    "openai-codex/gpt-6-sol",
    "openai-codex/gpt-6-astra"
  ],
  "hideThinkingBlock": false,
  "httpIdleTimeoutMs": 30000,
  "lastChangelogVersion": "0.85.1",
  "packages": [
    "git:github.com/thiagowfx/skills",
    "local/web-search",
    "npm:pi-tool-display@0.5.0",
    "npm:pi-mcp-adapter@2.34.0",
    "npm:@zeldrisho/pi-web-fetch@0.8.2",
    "npm:@nerisma/pi-auto-title@1.0.1",
    "npm:@ryan_nookpi/pi-extension-memory-layer@0.4.2",
    "npm:@tmustier/pi-session-recap@0.5.0",
    "npm:pi-team@0.6.11",
    "npm:@juicesharp/rpiv-ask-user-question@2.10.1",
    "npm:@juicesharp/rpiv-todo@2.10.1",
    "npm:@sreetej510/pi-usage@0.10.0"
  ],
  "retry": {
    "baseDelayMs": 2000,
    "enabled": true,
    "maxRetries": 5
