# lf configuration
# See `lf -doc` for documentation

# Delete selection / files
cmd remove delete

# Show hidden files by default
set hidden true

# Draw border separators
set drawbox true

# Edit file: 'e' (mapped out-of-the-box)
cmd edit-or-open ${{
    if [ -d "$f" ]; then
        "$lf" -remote "send $id open"
    else
        $EDITOR "$f"
    fi
}}
map <enter> edit-or-open

# Toggle hidden files: 'zh'
