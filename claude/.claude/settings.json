{
  "enabledPlugins": {
    "pyright-lsp@claude-plugins-official": true,
    "thiagowfx@thiagowfx": true
  },
  "env": {
    "CLAUDE_CODE_ENABLE_TELEMETRY": "0"
  },
  "extraKnownMarketplaces": {
    "thiagowfx": {
      "source": {
        "repo": "thiagowfx/skills",
        "source": "github"
      }
    }
  },
  "fallbackModel": [
    "sonnet"
  ],
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "command": "~/.claude/hooks/notify.sh",
            "type": "command"
          }
        ],
        "matcher": "permission_prompt|idle_prompt|elicitation_dialog"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "~/.claude/hooks/block_dangerous_commands.sh",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(gh issue view:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr review-comment list:*)",
      "Bash(gh pr view:*)",
      "Bash(gh run view:*)",
      "Bash(gh search:*)",
      "Bash(git check-ignore:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git rev-parse:*)",
      "Bash(git show:*)",
      "Bash(jq:*)",
      "Bash(ls:*)",
      "Bash(readlink:*)",
      "Bash(stat:*)",
      "Bash(test:*)",
      "Bash(tree:*)",
      "Bash(wc:*)"
    ],
    "defaultMode": "auto",
    "deny": [
      "Bash(rm -R:*)",
      "Bash(rm -r:*)"
    ]
  },
  "statusLine": {
    "command": "bash ~/.claude/statusline.sh",
    "type": "command"
  }
}
