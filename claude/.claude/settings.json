{
  "alwaysThinkingEnabled": false,
  "enabledPlugins": {
    "gopls-lsp@claude-plugins-official": true,
    "lua-lsp@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "ruby-lsp@claude-plugins-official": true,
    "terraform-skill@antonbabenko": true,
    "thiagowfx@thiagowfx": true,
    "typescript-lsp@claude-plugins-official": true
  },
  "env": {
    "CLAUDE_CODE_ENABLE_TELEMETRY": "0",
    "ENABLE_TOOL_SEARCH": "true"
  },
  "extraKnownMarketplaces": {
    "antonbabenko": {
      "source": {
        "repo": "antonbabenko/agent-plugins",
        "source": "github"
      }
    },
    "thiagowfx": {
      "source": {
        "repo": "thiagowfx/skills",
        "source": "github"
      }
    }
  },
  "fallbackModel": [
    "sonnet"
  ],
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "command": "~/.claude/hooks/notify.sh",
            "type": "command"
          }
        ],
        "matcher": "permission_prompt|idle_prompt|elicitation_dialog"
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "atuin hook claude-code",
            "timeout": 5,
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "command": "atuin hook claude-code",
            "timeout": 5,
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "~/.claude/hooks/block_dangerous_commands.sh",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "Bash"
      },
      {
        "hooks": [
          {
            "command": "atuin hook claude-code",
            "timeout": 5,
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(acli jira workitem view:*)",
      "Bash(afplay:*)",
      "Bash(ansible-doc:*)",
      "Bash(basename:*)",
      "Bash(brew info:*)",
      "Bash(cat:*)",
      "Bash(command -v:*)",
      "Bash(date:*)",
      "Bash(dir:*)",
      "Bash(echo:*)",
      "Bash(fd:*)",
      "Bash(find:*)",
      "Bash(gh api:*)",
      "Bash(gh issue view:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr review-comment list:*)",
      "Bash(gh pr view:*)",
      "Bash(gh run view:*)",
      "Bash(gh search:*)",
      "Bash(git add:*)",
      "Bash(git branch:*)",
      "Bash(git check-ignore:*)",
      "Bash(git commit:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git rev-parse:*)",
      "Bash(git run list:*)",
      "Bash(git show:*)",
      "Bash(go test:*)",
      "Bash(grep:*)",
      "Bash(hadolint:*)",
      "Bash(head:*)",
      "Bash(helm lint:*)",
      "Bash(helm template:*)",
      "Bash(jq:*)",
      "Bash(just --list:*)",
      "Bash(less:*)",
      "Bash(ls:*)",
      "Bash(md5sum:*)",
      "Bash(mktemp:*)",
      "Bash(mkdir:*)",
      "Bash(printf:*)",
      "Bash(pytest:*)",
      "Bash(readlink:*)",
      "Bash(rg:*)",
      "Bash(shellcheck:*)",
      "Bash(stat:*)",
      "Bash(tail:*)",
      "Bash(terraform validate:*)",
      "Bash(test:*)",
      "Bash(tflint:*)",
      "Bash(tr:*)",
      "Bash(tree:*)",
      "Bash(uuidgen:*)",
      "Bash(wc:*)",
      "Bash(xxd:*)",
      "Bash(yamllint:*)",
      "WebFetch(domain:api.github.com)",
      "WebFetch(domain:docs.github.com)",
      "WebFetch(domain:ghostty.org)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:perrotta.dev)",
      "WebSearch"
    ],
    "defaultMode": "auto",
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(terraform apply:*)",
      "Bash(terraform destroy:*)"
    ]
  },
  "showThinkingSummaries": true,
  "skipAutoPermissionPrompt": true,
  "skipDangerousModePermissionPrompt": true,
  "statusLine": {
    "command": "bash ~/.claude/statusline.sh",
    "type": "command"
  },
  "tui": "fullscreen"
}
