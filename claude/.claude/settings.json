{
  "alwaysThinkingEnabled": false,
  "enabledPlugins": {
    "pyright-lsp@claude-plugins-official": true,
    "thiagowfx@thiagowfx": true
  },
  "env": {
    "CLAUDE_CODE_ENABLE_TELEMETRY": "0"
  },
  "extraKnownMarketplaces": {
    "thiagowfx": {
      "source": {
        "repo": "thiagowfx/skills",
        "source": "github"
      }
    }
  },
  "fallbackModel": [
    "sonnet"
  ],
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "command": "~/.claude/hooks/notify.sh",
            "type": "command"
          }
        ],
        "matcher": "permission_prompt|idle_prompt|elicitation_dialog"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "~/.claude/hooks/block_dangerous_commands.sh",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(cat:*)",
      "Bash(fd:*)",
      "Bash(find:*)",
      "Bash(gh issue view:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr review-comment list:*)",
      "Bash(gh pr view:*)",
      "Bash(gh run view:*)",
      "Bash(gh search:*)",
      "Bash(git check-ignore:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git rev-parse:*)",
      "Bash(git show:*)",
      "Bash(grep:*)",
      "Bash(head:*)",
      "Bash(jq:*)",
      "Bash(less:*)",
      "Bash(ls:*)",
      "Bash(readlink:*)",
      "Bash(rg:*)",
      "Bash(stat:*)",
      "Bash(tail:*)",
      "Bash(test:*)",
      "Bash(tree:*)",
      "Bash(wc:*)",
      "WebFetch(domain:api.github.com)",
      "WebFetch(domain:docs.github.com)",
      "WebFetch(domain:ghostty.org)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:perrotta.dev)",
      "WebSearch"
    ],
    "defaultMode": "auto",
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(terraform apply:*)",
      "Bash(terraform destroy:*)"
    ]
  },
  "showThinkingSummaries": true,
  "skipAutoPermissionPrompt": true,
  "skipDangerousModePermissionPrompt": true,
  "statusLine": {
    "command": "bash ~/.claude/statusline.sh",
    "type": "command"
  },
  "tui": "fullscreen"
}
